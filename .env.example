# ==============================================================================
# 上海电信 IPTV 抓取与回看加速器 (Shanghai Telecom IPTV Spider)
# 环境变量配置模板 (.env.example)
#
# 使用方法:
# 1. 复制本文件为 .env: cp .env.example .env
# 2. 根据您的家庭网络环境与真实机顶盒抓包信息，修改下方参数
# 3. 运行程序: ./iptv-spider (程序将自动优先加载 .env 中的环境变量)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 系统与服务监听配置
# ------------------------------------------------------------------------------
# 服务监听地址与端口 (0.0.0.0 表示监听所有网卡)
SYSTEM_ADDR=0.0.0.0:8888

# HLS 回看切片缓存目录 (建议放置在 SSD 或 tmpfs 内存盘)
CACHE_DIR=/home/xlwang/hls_cache

# ------------------------------------------------------------------------------
# 2. 机顶盒身份鉴权信息 (隐私敏感信息，请勿提交至公共 Git 仓库)
# ------------------------------------------------------------------------------
# IPTV 业务账号 (通常为电信开户宽带关联的业务号，格式如: 4833xxxx@etv4)
STB_UID=4833xxxx@etv4

# 实体机顶盒有线网卡物理 MAC 地址 (小写，冒号分隔，如: 18:5e:0b:xx:xx:xx)
# 必须与克隆网卡 MAC 或抓包认证中的源 MAC 一致
STB_MAC=18:5e:0b:xx:xx:xx

# 实体机顶盒设备序列号 SN (24-32位字符串，可在机顶盒底壳条形码或抓包中查得)
STB_SN=00030032540702305260xxxx

# 虚拟机网卡通过 IPoE/DHCP 从电信 IPTV 内网 (VLAN 85) 分配到的 IP 地址
# 通常为 30.120.x.x 网段
STB_IP=30.120.xx.xx

# 机顶盒设备型号代码 (如中兴常见型号 B860AV2.1-T)
STB_TYPE=B860AV2.1-T

# 电信 EPG 统一鉴权门户地址 (上海电信通常为 222.68.208.73:7001)
STB_AUTH_HOST=222.68.208.73:7001

# ------------------------------------------------------------------------------
# 3. EPG 与播放列表地址生成配置 (客户端访问地址)
# ------------------------------------------------------------------------------
# 本服务对外暴露的 EPG XML 下载地址 (供 Tivimate / Kodi 订阅)
EPG_XML_URL=http://172.16.0.5:8888/api/epg.xml

# rtp2httpd 或 udpxy 的 RTSP 单播回看转发基地址
EPG_RTSP_URL=http://172.16.0.5:5140/rtsp/

# rtp2httpd 或 udpxy 的 RTP 组播直播转发基地址
EPG_RTP_URL=http://172.16.0.5:5140/rtp/

# 台标图标服务基地址
EPG_LOGO_URL=http://172.16.0.5:8888/logo/

# EPG 自动拉取定时任务表达式 (Cron 格式: 秒 分 时 日 月 周)
EPG_FETCH_CRON=0 0 8,16,23 * * *
